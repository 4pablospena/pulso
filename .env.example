# Strava: https://www.strava.com/settings/api  (Authorization Callback Domain: localhost en desarrollo)
NUXT_STRAVA_CLIENT_ID=
NUXT_STRAVA_CLIENT_SECRET=
# Cámara inteligente (Claude)
NUXT_ANTHROPIC_API_KEY=
# Token que enviará Health Auto Export / Atajos a /api/health/ingest
NUXT_HEALTH_INGEST_TOKEN=
# Contraseña de acceso (obligatoria al desplegar; sin ella, en local la app queda abierta)
NUXT_APP_PASSWORD=
